+package managers;
+
+import coaData.Adres;
+import scanner.MyScanner;
+
+import java.util.ArrayList;
+
+public class AdresManager {
+
+    private static AdresManager instance;
+    public static final ArrayList<Adres> alleAdressen = new ArrayList<>();
+    public static Adres actiefAdres;
+
+
+    private static AdresManager getInstance() {
+
+        if (instance == null) {
+
+            instance = new AdresManager();
+        }
+        return instance;
+    }
+
+
+    private AdresManager(){}
+
+
+    public static void setActiefAdres(Adres adres) {
+        actiefAdres = adres;
+    }
+
+
+    public static String vraagNaarPostcode() {
+        System.out.print("Postcode: ");
+        return MyScanner.nextLine();
+    }
+
+
+    public static String vraagNaarStraatnaam() {
+        System.out.print("Straatnaam: ");
+        return MyScanner.nextLine();
+    }
+
+
+    public static int vraagNaarHuisnummer() {
+        System.out.print("Huisnummer: ");
+        return MyScanner.nextInt();
+    }
+
+
+    public static Adres vraagNaarAdres() {
+        while (true) {
+            System.out.println("Geef adres op.");
+            Adres adres = getAdres(vraagNaarPostcode(), vraagNaarStraatnaam(), vraagNaarHuisnummer());
+
+            if (adres != null) {
+                return adres;
+            }
+            System.out.println("Dit adres staat niet in het systeem.");
+        }
+    }
+
+
+    public static Adres getAdres(String postcode, String straatnaam, int huisnummer) {
+
+        for (Adres a : alleAdressen) {
+
+            if (postcode.equalsIgnoreCase(a.getPostcode()) && straatnaam.equalsIgnoreCase(a.getStraatnaam()) && huisnummer == a.getHuisnummer()) {
+                return a;
+            }
+        }
+        return null;
+    }
+}
